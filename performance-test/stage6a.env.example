# Stage 6A benchmark private environment example.
# Copy to performance-test/stage6a.env with random dev-only passwords
# (stage6a.env is gitignored) and never commit or print real values.
# The benchmark profile disables Gateway Sentinel so raw service-chain numbers
# are measured (production defaults in backend/deploy remain untouched).

# --- MySQL ---
MYSQL_ROOT_PASSWORD=REQUIRED
MYSQL_IDENTITY_PASSWORD=REQUIRED
MYSQL_MERCHANT_PASSWORD=REQUIRED
MYSQL_TRANSACTION_PASSWORD=REQUIRED
MYSQL_SOCIAL_PASSWORD=REQUIRED

# --- Redis ACL ---
REDIS_ADMIN_PASSWORD=REQUIRED
REDIS_IDENTITY_PASSWORD=REQUIRED
REDIS_MERCHANT_PASSWORD=REQUIRED
REDIS_TRANSACTION_PASSWORD=REQUIRED
REDIS_SOCIAL_PASSWORD=REQUIRED
REDIS_GATEWAY_PASSWORD=REQUIRED

# --- Nacos 3.0.3 standalone (dev-only; Base64 token for the startup script) ---
NACOS_AUTH_TOKEN=REQUIRED
NACOS_AUTH_IDENTITY_KEY=REQUIRED
NACOS_AUTH_IDENTITY_VALUE=REQUIRED

# --- Business config ---
LINKLIFE_ADMIN_USER_IDS=1

# --- Sentinel (Stage 6A benchmark profile: Gateway rules OFF, 429=0) ---
LINKLIFE_SENTINEL_GATEWAY_ENABLED=false
LINKLIFE_SENTINEL_HOT_BLOG_QPS=100
LINKLIFE_SENTINEL_SHOP_OF_TYPE_QPS=100
LINKLIFE_SENTINEL_SECKILL_QPS=50
LINKLIFE_SENTINEL_IDENTITY_ENABLED=true
LINKLIFE_SENTINEL_IDENTITY_EXCEPTION_RATIO=0.5
LINKLIFE_SENTINEL_IDENTITY_MIN_REQUEST_AMOUNT=5
LINKLIFE_SENTINEL_IDENTITY_STAT_INTERVAL_MS=10000
LINKLIFE_SENTINEL_IDENTITY_TIME_WINDOW_SECONDS=5

# --- Local cache (Stage 5B A/B; runner toggles this between profiles) ---
LINKLIFE_LOCAL_CACHE_ENABLED=true
LINKLIFE_LOCAL_CACHE_SHOP_MAXIMUM_SIZE=10000
LINKLIFE_LOCAL_CACHE_SHOP_TTL_SECONDS=10
LINKLIFE_LOCAL_CACHE_SHOP_TYPE_MAXIMUM_SIZE=16
LINKLIFE_LOCAL_CACHE_SHOP_TYPE_TTL_SECONDS=60
