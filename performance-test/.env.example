# LinkLife performance-test tool environment example.
# Copy to a private local env file and fill in local test-only dev passwords.
# This is a test-tool example only: never commit real passwords.
# Defaults match the final microservice toolchain (Gateway 127.0.0.1:8080,
# 4 separate databases, Redis DB0 + ACL). Historical legacy single-DB
# defaults are no longer used by any executable configuration.
LINKLIFE_BASE_URL=http://127.0.0.1:8080/api
LINKLIFE_MYSQL_HOST=127.0.0.1
LINKLIFE_MYSQL_PORT=13306
LINKLIFE_MYSQL_USER=root
LINKLIFE_MYSQL_PASSWORD=<LOCAL_MYSQL_PASSWORD>
LINKLIFE_MYSQL_DATABASE=linklife_identity
LINKLIFE_TRANSACTION_DATABASE=linklife_transaction
LINKLIFE_REDIS_HOST=127.0.0.1
LINKLIFE_REDIS_PORT=16379
LINKLIFE_REDIS_DB=0
LINKLIFE_REDIS_PASSWORD=<LOCAL_REDIS_ADMIN_PASSWORD>
LINKLIFE_JMETER_HOME=<JMETER_HOME>
LINKLIFE_ADMIN_TOKEN=<LOCAL_ADMIN_TOKEN>
